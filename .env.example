# --- Flask ---
SECRET_KEY=change-me
# Needed so the `flask` CLI (init-db, create-admin) works inside the container
FLASK_APP=run.py
# Default points at the bundled MariaDB service (see docker-compose.yml)
DATABASE_URL=mysql+pymysql://flightdeck:flightdeck@db:3306/flightdeck

# Set to 1 when serving over HTTPS so session cookies get the Secure flag
COOKIE_SECURE=0

# Password used once by `flask create-admin` to bootstrap the admin account
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong

# --- Nginx / TLS (only needed for the HTTPS production setup) ---
DOMAIN=flightdeck.example.com
ALT_DOMAIN=www.flightdeck.example.com
CERT_NAME=flightdeck.example.com
LETSENCRYPT_EMAIL=admin@example.com

# --- MariaDB ---
MARIADB_DATABASE=flightdeck
MARIADB_USER=flightdeck
MARIADB_PASSWORD=flightdeck
MARIADB_ROOT_PASSWORD=rootsecret
